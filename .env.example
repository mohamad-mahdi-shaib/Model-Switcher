# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
#
# .env.local is git-ignored and is read only on the server. The key is never
# sent to the browser: do NOT rename these to NEXT_PUBLIC_*.
#
# Get a key from Google AI Studio: https://aistudio.google.com/apikey

GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (stable, free tier, widely available).
GEMINI_MODEL=gemini-3.6-flash
