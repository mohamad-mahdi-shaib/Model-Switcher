# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
#
# .env.local is git-ignored and is read only on the server, inside provider
# adapters. The key never reaches the browser: do NOT rename these to
# NEXT_PUBLIC_*.

# --- Gemini (the live provider) -------------------------------------------
# Free key, no billing required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (stable, free tier, widely available).
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (second live provider) ------------------------------------------
# Requires a funded account: https://platform.openai.com/api-keys
# A key alone marks GPT "configured", which means the server has a key -- NOT
# that the key is valid or that the account has credit. Neither can be known
# without spending a request.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna, the cost-optimised tier
# ($0.20 / $1.20 per MTok at time of writing).
OPENAI_MODEL=gpt-5.6-luna

# --- Reserved for additional providers -------------------------------------
# No adapter ships for Anthropic yet. Setting a key alone does NOT enable a
# provider; see "Adding another provider" in README.md.
# ANTHROPIC_API_KEY=
