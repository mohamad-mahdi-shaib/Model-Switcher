# Copy this file to .env.local and fill in your key.
#   cp .env.example .env.local
#
# .env.local is git-ignored and is read only on the server, inside provider
# adapters. The key never reaches the browser: do NOT rename these to
# NEXT_PUBLIC_*.

# --- Gemini (the live provider) -------------------------------------------
# Free key, no billing required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash (stable, free tier, widely available).
GEMINI_MODEL=gemini-3.6-flash

# --- OpenAI (second live provider) ------------------------------------------
# Requires a funded account: https://platform.openai.com/api-keys
# A key alone marks GPT "configured", which means the server has a key -- NOT
# that the key is valid or that the account has credit. Neither can be known
# without spending a request.
OPENAI_API_KEY=

# Optional. Defaults to gpt-5.6-luna, the cost-optimised tier
# ($0.20 / $1.20 per MTok at time of writing).
OPENAI_MODEL=gpt-5.6-luna

# --- OpenRouter (Project 3: vision models, image generation, tool calling) ---
# One key serves all three OpenRouter-backed chat models AND image generation.
# Create one at https://openrouter.ai/keys  (needs credit for paid models).
# Server-side only: never rename this to NEXT_PUBLIC_*.
OPENROUTER_API_KEY=

# Optional. Overrides the image-generation model. The default is
# google/gemini-2.5-flash-image, confirmed image-in/image-out in OpenRouter's
# own catalogue. Other confirmed options: google/gemini-3.1-flash-image,
# google/gemini-3-pro-image, openai/gpt-5-image.
OPENROUTER_IMAGE_MODEL=

# Optional attribution headers OpenRouter uses for its public rankings.
# Neither is a secret; both are omitted from requests when unset.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=

# --- Image storage (optional) -----------------------------------------------
# When set, generated images are uploaded to Vercel Blob and the conversation
# keeps a short https URL instead of a large base64 string. Without it the app
# still works: images are held inline in the conversation in this browser.
# On Vercel this is created for you when you add a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# --- Reserved for additional providers -------------------------------------
# No adapter ships for Anthropic yet. Setting a key alone does NOT enable a
# provider; see "Adding another provider" in README.md.
# ANTHROPIC_API_KEY=
